{
  "name": "Checkin",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "morning",
        "evening",
        "quick"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "gray"
      ]
    },
    "energy": {
      "type": "number"
    },
    "mood": {
      "type": "number"
    },
    "stress": {
      "type": "number"
    },
    "focus": {
      "type": "number"
    },
    "sleep": {
      "type": "number"
    },
    "motivation": {
      "type": "number"
    },
    "overwhelm": {
      "type": "number"
    },
    "gratitude": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "went_well": {
      "type": "string"
    },
    "tomorrow_priority": {
      "type": "string"
    },
    "day_key": {
      "type": "string"
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}