{
  "name": "Reminder",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "remind_at": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "time",
        "appointment",
        "deadline",
        "preparation",
        "follow_up",
        "bill",
        "birthday",
        "routine",
        "decision"
      ],
      "enumColors": [
        "gray",
        "blue",
        "red",
        "yellow",
        "purple",
        "yellow",
        "pink",
        "green",
        "blue"
      ]
    },
    "recurrence": {
      "type": "string",
      "enum": [
        "none",
        "daily",
        "weekly",
        "monthly",
        "yearly"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple",
        "green",
        "yellow"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "done",
        "snoozed",
        "dismissed"
      ],
      "enumColors": [
        "blue",
        "green",
        "yellow",
        "gray"
      ]
    },
    "snooze_until": {
      "type": "string"
    },
    "related_type": {
      "type": "string",
      "enum": [
        "task",
        "event",
        "note",
        "goal",
        "none"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple",
        "green",
        "gray"
      ]
    },
    "related_id": {
      "type": "string"
    },
    "area_id": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}