{
  "name": "AiMemory",
  "type": "object",
  "properties": {
    "content": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "assistant",
        "manual",
        "onboarding"
      ],
      "enumColors": [
        "blue",
        "gray",
        "purple"
      ]
    },
    "active": {
      "type": "boolean"
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}